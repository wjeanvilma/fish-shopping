# Phase 22 — optional cloud save (anonymous Identity Toolkit + Firestore REST).
# Leave blank for local-only play. Never commit real keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Phase 2 (post-1.0) — optional web IAP checkout API (Stripe-backed or equivalent).
# Leave blank to keep the local entitlements stub. Never commit real keys.
# Finish 2.0 Phase 25 — local emulator: npm run checkout-api:dev
# then set VITE_BILLING_API_BASE=http://localhost:8787
# Finish 3.0 Phase 16 — live Stripe: set CHECKOUT_API_MODE=live on checkout-api
# with STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET (never commit). Publishable key
# is client-only; checkout still goes through checkout-api.
VITE_BILLING_API_BASE=
VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_BILLING_FORCE_STUB=true

# Finish 3.0 Phase 26 — optional remote analytics batch sink.
# Leave blank for local-only counters (dashboard still works with consent).
# Local emulator: npm run analytics-api:dev then set:
# VITE_ANALYTICS_API_BASE=http://localhost:8788
VITE_ANALYTICS_API_BASE=

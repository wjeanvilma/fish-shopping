{
  "name": "fish-shopping-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Fish Shopping web client: TypeScript + React + Three.js (WebGL 2). Shares content and parity fixtures with the Android client via ../shared.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content:validate": "vite-node scripts/validate-content.ts",
    "content:catalog": "vite-node scripts/validate-content.ts --catalog",
    "billing:validate": "vite-node scripts/validate-store-catalog.ts",
    "pages:legal": "vite-node scripts/build-legal-pages.ts",
    "pages:site": "vite-node scripts/build-pages-site.ts",
    "landing:validate": "vite-node scripts/validate-landing-play-cta.ts",
    "spa:validate": "vite-node scripts/validate-spa-host.ts",
    "complete:pin": "vite-node scripts/pin-complete-release.ts",
    "complete:validate": "vite-node scripts/validate-complete-tag.ts",
    "data-safety:validate": "vite-node scripts/validate-data-safety.ts",
    "screenshots:capture": "python3 ../shared/tools/capture_store_screenshots.py",
    "screenshots:validate": "vite-node scripts/validate-screenshot-capture.ts",
    "icons:generate": "python3 ../shared/tools/generate_store_chrome.py",
    "icons:validate": "vite-node scripts/validate-icon-pack.ts",
    "listing-copy:validate": "vite-node scripts/validate-listing-copy.ts",
    "licenses:validate": "vite-node scripts/validate-licenses.ts",
    "lifecycle:android:validate": "vite-node scripts/validate-android-lifecycle.ts",
    "lifecycle:browser:validate": "vite-node scripts/validate-browser-matrix.ts",
    "perf:budget": "vite-node scripts/validate-perf-budget.ts",
    "a11y:validate": "vite-node scripts/validate-a11y-sweep.ts",
    "closed-test:validate": "vite-node scripts/validate-closed-testing.ts",
    "public-ship:hash": "vite-node scripts/pin-store-hashes.ts",
    "public-ship:hash:artifacts": "vite-node scripts/pin-store-hashes.ts -- --artifacts",
    "public-ship:validate": "vite-node scripts/validate-public-ship.ts",
    "sfx:generate": "python3 ../shared/tools/generate_sfx_pack.py",
    "sfx:validate": "vite-node scripts/validate-sfx-pack.ts",
    "music:generate": "python3 ../shared/tools/generate_music_pack.py",
    "music:validate": "vite-node scripts/validate-music-pack.ts",
    "vfx:validate": "vite-node scripts/validate-vfx-juice.ts",
    "tutorial:validate": "vite-node scripts/validate-tutorial-friction.ts",
    "balance:validate": "vite-node scripts/validate-balance-patch.ts",
    "cosmetics:validate": "vite-node scripts/validate-cosmetic-presentation.ts",
    "cloud:validate": "vite-node scripts/validate-cloud-cutover.ts",
    "analytics:validate": "vite-node scripts/validate-analytics-dashboard.ts",
    "parity:validate": "vite-node scripts/validate-parity-lock.ts",
    "support:validate": "vite-node scripts/validate-support-runbook.ts",
    "hotfix:validate": "vite-node scripts/validate-hotfix-lane.ts",
    "dod:validate": "vite-node scripts/validate-dod-closeout.ts",
    "pages:live": "vite-node scripts/validate-pages-legal-live.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}

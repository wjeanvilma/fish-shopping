# Finish 2.0 Phase 25 — local web checkout API (no real payment secrets)
# Finish 3.0 Phase 16 — live Stripe placeholders (leave empty unless operating live)
# Finish 4.0 Phase 25 — live-ready catalog ops (GET /v1/ops/readiness; webhook idempotency)
PORT=8787
CHECKOUT_API_MODE=stub
# Instant fulfill on POST /v1/checkout (1 = stub completed; 0 = return checkout.url sandbox)
# Live mode always disables instant.
CHECKOUT_API_INSTANT=1
# Public base used when building checkout.url in non-instant sandbox mode
CHECKOUT_API_PUBLIC_BASE=http://localhost:8787
# Live Stripe (CHECKOUT_API_MODE=live) — never commit real values
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional per-SKU overrides (defaults come from web-checkout-products.json stripePriceId)
# STRIPE_PRICE_FISH_FULL_HARBOR_UNLOCK=
# Ops readiness: GET /v1/ops/readiness (catalogOk / priceMapOk / liveReady)

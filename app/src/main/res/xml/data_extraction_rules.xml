<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 27 — Autobackup / cloud-backup rules (API 31+).
  Exclude corruptible local save slots (latest/previous + AtomicFile .new).
  Entitlement stub prefs are restored via billing restore, not Autobackup.
  Presentation settings SharedPreferences may backup.
  See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="fish_shopping_entitlements.xml" />
        <exclude domain="file" path="harbor_save_latest.json" />
        <exclude domain="file" path="harbor_save_previous.json" />
        <exclude domain="file" path="harbor_save_latest.json.new" />
        <exclude domain="file" path="harbor_save_previous.json.new" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="fish_shopping_entitlements.xml" />
        <exclude domain="file" path="harbor_save_latest.json" />
        <exclude domain="file" path="harbor_save_previous.json" />
        <exclude domain="file" path="harbor_save_latest.json.new" />
        <exclude domain="file" path="harbor_save_previous.json.new" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 27 — full-backup-content for API &lt; 31 (ignored on 31+; see data_extraction_rules).
  Same excludes as cloud-backup: corruptible harbor save slots + entitlement stub prefs.
  File-domain include is required so path excludes are valid under FullBackupContent lint.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <exclude domain="sharedpref" path="fish_shopping_entitlements.xml" />
    <exclude domain="file" path="harbor_save_latest.json" />
    <exclude domain="file" path="harbor_save_previous.json" />
    <exclude domain="file" path="harbor_save_latest.json.new" />
    <exclude domain="file" path="harbor_save_previous.json.new" />
</full-backup-content>

  "type": {
    "family": "system sans-serif",
    "numeric": "tabular figures for quantities and coins",
    "scale": { "caption": 12, "body": 14, "label": 16, "title": 20, "display": 28 }
  },
  "designSystem": {
    "components": ["Pill", "Panel", "PrimaryButton", "GhostButton", "Scrim", "CenterCard"]

{
  "description": "Design tokens shared by the Compose HUD and the web CSS. Finish 3.0 Phase 7 adds dark theme palettes; light values stay the brand baseline.",
  "color": {
    "ink": { "value": "#153449", "use": "Primary text and outlines (light)" },
    "action": { "value": "#008F95", "use": "Primary actions and active stations" },

    "onAction": { "value": "#FFFFFF", "use": "Text on action color" },
    "danger": { "value": "#B3412E", "use": "Blocked states and errors" },
    "water": { "value": "#2E7FA8", "use": "3D water tint and sky clear colour reference" },
    "muted": { "value": "#4A5D68", "use": "Secondary text (light)" },
    "sky": { "value": "#9FD3EA", "use": "Page/sky fill behind HUD (light)" },
    "rewardText": { "value": "#8A5A10", "use": "Dark gold text on light surfaces" }
  },
  "colorDark": {
    "ink": { "value": "#E8F1F6", "use": "Primary text on dark panels" },
    "action": { "value": "#2BB8BE", "use": "Primary actions (dark)" },
    "reward": { "value": "#F0C15A", "use": "Coins and completed goals (dark)" },
    "surface": { "value": "#1A2A35", "use": "Dark panel fill" },
    "surfaceMuted": { "value": "#243744", "use": "Secondary dark panel fill" },
    "onAction": { "value": "#082226", "use": "Text on action color (dark)" },
    "danger": { "value": "#E57368", "use": "Blocked states and errors (dark)" },
    "water": { "value": "#3A8FBA", "use": "Water/sky reference (dark)" },
    "muted": { "value": "#9BB0BC", "use": "Secondary text (dark)" },
    "sky": { "value": "#0E1A22", "use": "Page fill behind HUD (dark)" },
    "rewardText": { "value": "#F0C15A", "use": "Gold text on dark surfaces" }
  },
  "theme": {
    "preferences": ["system", "light", "dark"],
    "defaultPreference": "system"
  },
  "size": {
    "minTouchTargetDp": 48,
    "joystickDiameterDp": 140,
    "actionButtonDp": 84,
    "panelCornerDp": 16,
    "safeMarginDp": 16

{
  "phase": 14,
  "schema": "fish.lifecycle.browser_matrix.v1",
  "description": "Post-1.0 Phase 14 — browser QA matrix. Finish 6.0 Phase 28 adds Safari iOS + nest deeplink/page-lifecycle scenarios.",
  "phase28Catalog": "shared/lifecycle/browser-lifecycle.json",
  "finish4Phase": 27,
  "browsers": [
    {
      "id": "chrome",
      "label": "Chrome / Chromium",
      "engines": [
        "Blink"
      ],
      "minNotes": "Current stable; hardware acceleration on",
      "webgl2": "required",
      "indexedDb": "persistent",
      "audioUnlock": [
        "pointerdown",
        "keydown",
        "touchstart"
      ]
    },
    {
      "id": "edge",
      "label": "Microsoft Edge",
      "engines": [
        "Blink"
      ],
      "minNotes": "Finish 4.0 Phase 27 — Chromium Edge stable; same WebGL2 + gesture unlock path as Chrome",
      "webgl2": "required",
      "indexedDb": "persistent",
      "audioUnlock": [
        "pointerdown",
        "keydown",
        "touchstart"
      ]
    },
    {
      "id": "firefox",
      "label": "Firefox",
      "engines": [
        "Gecko"
      ],
      "minNotes": "Current stable; WebGL2 enabled",
      "webgl2": "required",
      "indexedDb": "persistent",
      "audioUnlock": [
        "pointerdown",
        "keydown",
        "touchstart"
      ]
    },
    {
      "id": "safari",
      "label": "Safari (macOS / iOS)",
      "engines": [
        "WebKit"
      ],
      "minNotes": "Safari 15+ WebGL2; iOS needs touchstart for AudioContext",
      "webgl2": "required",
      "indexedDb": "persistent_or_private_memory",
      "audioUnlock": [
        "pointerdown",
        "keydown",
        "touchstart"
      ],
      "notes": [
        "Private / ITP windows may force memory-only saves",
        "Autoplay policy requires a user gesture before Web Audio"
      ]
    },
    {
      "id": "chrome_android",
      "label": "Chrome for Android",
      "engines": [
        "Blink"
      ],
      "minNotes": "Finish 5.0 Phase 27 — mobile Chrome WebGL2 + touch unlock; denser scene budgets",
      "webgl2": "required",
      "indexedDb": "persistent",
      "audioUnlock": [
        "pointerdown",
        "keydown",
        "touchstart"
      ]
    },
    {
      "id": "safari_ios",
      "label": "Safari on iOS",
      "engines": [
        "WebKit"
      ],
      "minNotes": "Finish 6.0 Phase 28 — iOS Safari WebGL2 + touchstart unlock; nest deeplink resume",
      "webgl2": "required",
      "indexedDb": "persistent_or_private_memory",
      "audioUnlock": [
        "pointerdown",
        "keydown",
        "touchstart"
      ],
      "notes": [
        "ITP may force memory-only saves in private mode",
        "Nest deeplink resume must re-unlock audio on first tap"
      ]
    }
  ],
  "scenarios": [
    {
      "id": "webgl2_gate",
      "title": "WebGL 2 availability gate",
      "trigger": "hasWebGL2() false on boot",
      "expects": [
        "showGateCopy",
        "noHarborScene"
      ],
      "hostHooks": [
        "web/src/ui/App.tsx",
        "web/src/render/HarborScene.ts#hasWebGL2"
      ],
      "phase28Keys": [
        "web.webgl2Required",
        "web.webgl2GateCopy"
      ]
    },
    {
      "id": "context_loss",
      "title": "WebGL context lost / restored",
      "trigger": "webglcontextlost then webglcontextrestored",
      "expects": [
        "preventDefaultOnLost",
        "pauseRenderWhileLost",
        "bannerCopy",
        "reloadHarborOnRestore"
      ],
      "hostHooks": [
        "HarborScene.onContextLost",
        "HarborScene.onContextRestored",
        "App context banner"
      ],
      "phase28Keys": [
        "web.contextLoss"
      ]
    },
    {
      "id": "storage_quota",
      "title": "IndexedDB unavailable or QuotaExceeded",
      "trigger": "indexedDB missing / blocked / QuotaExceededError on write",
      "expects": [
        "fallbackMemoryStore",
        "persistentFalse",
        "titleToastWhenMemoryOnly",
        "settingsLabel"
      ],
      "hostHooks": [
        "web/src/game/saveStore.ts",
        "openSaveStore",
        "quotaAwareWrite"
      ],
      "phase28Keys": [
        "web.storageUnavailable"
      ]
    },
    {
      "id": "audio_unlock",
      "title": "Web Audio unlock on gesture",
      "trigger": "pointerdown / keydown / touchstart before first tone",
      "expects": [
        "unlockOnGesture",
        "resumeSuspendedContext",
        "suspendOnVisibilityHidden",
        "keepUnlockAcrossSuspend"
      ],
      "hostHooks": [
        "App audioUnlockEvents",
        "GameHost.unlockAudio",
        "AudioBus"
      ],
      "phase28Keys": [
        "web.audioGesture",
        "web.tabLifecycle.suspendAudioWhenHidden"
      ]
    },
    {
      "id": "visibility_hidden",
      "title": "Tab visibility hide / show",
      "trigger": "document.visibilitychange → hidden then visible",
      "expects": [
        "suspendOnVisibilityHidden",
        "resumeOnVisibilityVisible",
        "keepUnlockAcrossSuspend"
      ],
      "hostHooks": [
        "App.tsx visibilitychange",
        "GameHost pause/resume"
      ],
      "phase28Keys": [
        "web.tabLifecycle.suspendAudioWhenHidden"
      ]
    },
    {
      "id": "pwa_offline",
      "title": "PWA offline shell",
      "trigger": "Service worker registered; network offline navigates to offline.html",
      "expects": [
        "serviceWorkerRegistered",
        "offlineShellServed",
        "playRouteCached"
      ],
      "hostHooks": [
        "web/src/pwa/registerServiceWorker.ts",
        "web/public/offline.html",
        "web/public/sw.js"
      ],
      "phase28Keys": [
        "web.pwa"
      ]
    },
    {
      "id": "reduced_motion",
      "title": "Reduced motion presentation budget",
      "trigger": "settings.reducedMotion true during harbor render",
      "expects": [
        "skipFlyingTransfers",
        "skipWorldBursts",
        "skipScreenShake",
        "simUnchanged"
      ],
      "hostHooks": [
        "HarborScene.render reducedMotion",
        "presenters crowd/flying"
      ],
      "phase28Keys": [
        "web.a11y.reducedMotion"
      ]
    },
    {
      "id": "bfcache_restore",
      "title": "Back/forward cache restore",
      "trigger": "Navigate away then back; page restored from bfcache",
      "expects": [
        "resumeOnVisibilityVisible",
        "keepUnlockAcrossSuspend"
      ],
      "hostHooks": [
        "App.tsx pageshow",
        "GameHost pause/resume"
      ],
      "phase28Keys": [
        "web.tabLifecycle.suspendAudioWhenHidden"
      ]
    },
    {
      "id": "persistent_storage",
      "title": "Persistent storage grant",
      "trigger": "navigator.storage.persist() granted after first play",
      "expects": [
        "persistentFalse",
        "titleToastWhenMemoryOnly",
        "settingsLabel"
      ],
      "hostHooks": [
        "web/src/game/saveStore.ts",
        "openSaveStore"
      ],
      "phase28Keys": [
        "web.storageUnavailable"
      ]
    },
    {
      "id": "nest_deeplink_resume",
      "title": "Nest deeplink resume",
      "trigger": "Open /play?panel=nest (or hash) after cold load",
      "expects": [
        "resumeOnVisibilityVisible",
        "unlockOnGesture"
      ],
      "hostHooks": [
        "App.tsx deep link",
        "GameHost.pendingDeepLink"
      ],
      "phase28Keys": [
        "web.audioGesture",
        "web.tabLifecycle.suspendAudioWhenHidden"
      ]
    },
    {
      "id": "page_lifecycle_freeze",
      "title": "Page Lifecycle freeze / resume",
      "trigger": "document freeze/resume (Chrome Page Lifecycle)",
      "expects": [
        "suspendOnVisibilityHidden",
        "resumeOnVisibilityVisible",
        "keepUnlockAcrossSuspend"
      ],
      "hostHooks": [
        "App.tsx freeze/resume",
        "GameHost pause/resume"
      ],
      "phase28Keys": [
        "web.tabLifecycle.suspendAudioWhenHidden"
      ]
    }
  ],
  "audioUnlockEvents": [
    "pointerdown",
    "keydown",
    "touchstart"
  ],
  "webgl2Required": true,
  "storageQuota": {
    "fallback": "memory",
    "detectNames": [
      "QuotaExceededError",
      "NS_ERROR_DOM_QUOTA_REACHED"
    ],
    "probeEstimate": true
  },
  "manualChecklist": [
    "Chrome: load game, confirm harbor renders; DevTools → Sensors → lose WebGL context",
    "Edge: same WebGL2 + tab hide/show audio mute/unmute",
    "Firefox: same WebGL2 + tab hide/show audio mute/unmute",
    "Safari macOS: first click unlocks audio; private window shows memory-only save label",
    "Safari iOS: touchstart unlocks audio; rotate portrait/landscape HUD reflows",
    "Fill storage / block site data → title toast + Settings memory-only label; play still works",
    "PWA: install / offline → offline.html shell; Play still boots when online again",
    "Settings → reduced motion On → no fly/burst/shake; sim tick unchanged",
    "Safari iOS: nest deeplink opens panel; first tap unlocks audio",
    "Chrome: Page Lifecycle freeze → resume keeps unlock + harbor scene",
    "Nest deeplink: /play?panel=nest after cold load resumes without blank WebGL"
  ],
  "failCriteria": [
    "Blank screen with no WebGL2 gate copy",
    "Context loss without preventDefault (no restore)",
    "QuotaExceededError crashes the tab or blocks title Play",
    "Safari iOS never unlocks AudioContext after first tap",
    "Reduced motion still plays fly/burst/shake VFX"
  ],
  "finish5Phase": 27,
  "finish6Phase": 28
}

{
  "phase": 29,
  "licensesUiPhase": 12,
  "schema": "fish.store.asset_licenses.v1",
  "description": "Asset rights + Phase 12 in-app OSS notices for Play / web ship.",
  "screenTitle": "Licenses & notices",
  "screenIntro": "Fish Shopping art, audio, and content are first-party. Runtime engines and libraries keep their upstream licenses.",
  "catalogPath": "shared/store/licenses.json",
  "defaultLicense": {
    "holder": "Fish Shopping project (Willio / Jeanvilma)",
    "spdx": "LicenseRef-FishShopping-Proprietary-Ship",
    "note": "Created for Fish Shopping. May be redistributed with the game clients. Third-party reuse outside the game requires written permission."
  },
  "records": [
    {
      "id": "harbor-blockouts",
      "paths": ["shared/assets/models/*_blockout.glb"],
      "kind": "3d",
      "origin": "first_party_generated",
      "tool": "shared/tools/generate_blockout.py",
      "rights": "original"
    },
    {
      "id": "env-modules",
      "paths": ["shared/assets/models/modules/*.glb"],
      "kind": "3d",
      "origin": "first_party_generated",
      "tool": "shared/tools/generate_env_modules.py",
      "rights": "original"
    },
    {
      "id": "character-modules",
      "paths": ["shared/assets/models/characters/*.glb"],
      "kind": "3d",
      "origin": "first_party_generated",
      "tool": "shared/tools/generate_character_modules.py",
      "rights": "original"
    },
    {
      "id": "item-art",
      "paths": ["shared/assets/models/fish_*.glb", "shared/assets/models/product_*.glb"],
      "kind": "3d",
      "origin": "first_party_generated",
      "tool": "shared/tools/generate_fish_stubs.py",
      "rights": "original"
    },
    {
      "id": "store-chrome",
      "paths": [
        "shared/store/brand-mark.svg",
        "shared/store/feature-graphic.svg",
        "shared/store/feature-graphic.png",
        "shared/store/play-icon-512.png",
        "web/public/favicon.svg",
        "web/public/apple-touch-icon.png",
        "web/public/icon-192.png",
        "web/public/icon-512.png",
        "web/public/icon-512-maskable.png",
        "app/src/main/res/mipmap-*/ic_launcher*.png",
        "app/src/main/res/drawable/ic_launcher_*.xml",
        "app/src/main/res/drawable/ic_brand_mark.xml"
      ],
      "kind": "2d",
      "origin": "first_party_authored",
      "tool": "shared/tools/generate_store_chrome.py",
      "rights": "original",
      "note": "Phase 10 final icon pack + Play feature graphic."
    },
    {
      "id": "screenshot-storyboards",
      "paths": ["shared/store/screenshots/*.svg"],
      "kind": "2d",
      "origin": "first_party_authored",
      "rights": "original",
      "note": "Storyboard placeholders for Play Console capture; feed shared/tools/capture_store_screenshots.py."
    },
    {
      "id": "screenshot-captures",
      "paths": [
        "shared/store/screenshots/captures/phone/*.png",
        "shared/store/screenshots/captures/tablet/*.png"
      ],
      "kind": "2d",
      "origin": "first_party_authored",
      "tool": "shared/tools/capture_store_screenshots.py",
      "rights": "original",
      "note": "Phase 9 phone + tablet Play-sized PNGs rasterized from storyboards; swap for live device captures before public submit if desired."
    },
    {
      "id": "authored-sfx",
      "paths": [
        "shared/audio/sfx/*.wav",
        "web/public/sfx/*.wav",
        "app/src/main/res/raw/sfx_*.wav"
      ],
      "kind": "audio",
      "origin": "first_party_authored",
      "tool": "shared/tools/generate_sfx_pack.py",
      "rights": "original",
      "note": "Phase 19 mono WAV stingers for catch/cut/sell/UI (plus abandon, upgrade, rush). Baked offline; no third-party sample packs."
    },
    {
      "id": "authored-music",
      "paths": [
        "shared/audio/music/*.wav",
        "web/public/music/*.wav",
        "app/src/main/res/raw/music_*.wav"
      ],
      "kind": "audio",
      "origin": "first_party_authored",
      "tool": "shared/tools/generate_music_pack.py",
      "rights": "original",
      "note": "Phase 20 harbor/shop loop beds with mute, SFX duck, and focus-loss duck/silence. No third-party sample packs."
    },
    {
      "id": "content-pack",
      "paths": ["shared/content/content-pack.json"],
      "kind": "data",
      "origin": "first_party_authored",
      "rights": "original"
    },
    {
      "id": "third-party-runtime",
      "paths": [],
      "kind": "runtime",
      "origin": "third_party_dependency",
      "rights": "dependency_licenses",
      "note": "See ossNotices for Filament, Three.js, React, Kotlin, AndroidX/Compose, and related SPDX attributions shown in Settings → Licenses."
    }
  ],

{
  "phase": 10,
  "schema": "fish.store.icon_pack.v1",
  "description": "Final launcher / adaptive / Play feature graphic / web favicon + PWA icon pack. Regenerated by shared/tools/generate_store_chrome.py.",
  "packageName": "com.willio.jeanvilma.fishshopping",
  "brandColors": {
    "ink": "#153449",
    "sky": "#9fd3ea",
    "reward": "#e8af4a",
    "action": "#008f95"
  },
  "sourceMark": "shared/store/brand-mark.svg",
  "tool": "shared/tools/generate_store_chrome.py",
  "npmScript": "icons:generate",
  "validateScript": "icons:validate",
  "featureGraphic": {
    "svg": "shared/store/feature-graphic.svg",
    "png": "shared/store/feature-graphic.png",
    "width": 1024,
    "height": 500,
    "playRequirement": "Exactly 1024×500 PNG for Play Console feature graphic"
  },
  "playHiResIcon": {
    "path": "shared/store/play-icon-512.png",
    "width": 512,
    "height": 512,
    "playRequirement": "512×512 PNG high-res icon"
  },
  "android": {
    "adaptiveIcon": "app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml",
    "adaptiveIconRound": "app/src/main/res/mipmap-anydpi-v26/ic_launcher_round.xml",
    "foreground": "app/src/main/res/drawable/ic_launcher_foreground.xml",
    "background": "app/src/main/res/drawable/ic_launcher_background.xml",
    "legacyMipmaps": {
      "mipmap-mdpi": 48,
      "mipmap-hdpi": 72,
      "mipmap-xhdpi": 96,
      "mipmap-xxhdpi": 144,
      "mipmap-xxxhdpi": 192
    }
  },
  "web": {
    "faviconSvg": "web/public/favicon.svg",
    "appleTouchIcon": { "path": "web/public/apple-touch-icon.png", "width": 180, "height": 180 },
    "icon192": { "path": "web/public/icon-192.png", "width": 192, "height": 192 },
    "icon512": { "path": "web/public/icon-512.png", "width": 512, "height": 512 },
    "icon512Maskable": {
      "path": "web/public/icon-512-maskable.png",
      "width": 512,
      "height": 512,
      "padRatio": 0.1,
      "note": "Safe-zone padding for maskable / adaptive-like crops"
    },
    "manifest": "web/public/manifest.webmanifest"
  }
}

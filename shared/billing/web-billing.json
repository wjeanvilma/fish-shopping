{
  "phase": 2,
  "schema": "fish.billing.web_production.v1",
  "description": "Web production IAP path for non-consumable full-harbor unlock and cosmetics. Uses the same logical SKUs as Android; maps via webProductId. Local stub when VITE_BILLING_API_BASE is unset. Finish 2.0 Phase 25 ships the in-repo checkout-api emulator that implements this contract.",
  "provider": "checkout_api",
  "productType": "non_consumable",
  "localBackend": "stub",
  "productionBackend": "web",
  "forceStubEnv": "VITE_BILLING_FORCE_STUB",
  "finish2CheckoutApiPhase": 25,
  "finish3StripeLivePhase": 16,
  "stripeLiveCatalog": "shared/ship/stripe-live-checkout.json",
  "moduleCatalog": "shared/ship/web-checkout-api.json",
  "localEmulator": "checkout-api/",
  "catalog": "shared/billing/entitlements.json",
  "envKeys": [
    {
      "name": "VITE_BILLING_API_BASE",
      "required": true,
      "description": "HTTPS base for checkout + entitlement restore (no trailing slash)"
    },
    {
      "name": "VITE_STRIPE_PUBLISHABLE_KEY",
      "required": false,
      "description": "Optional Stripe publishable key when the checkout API uses Stripe Checkout/Elements"
    },
    {
      "name": "VITE_BILLING_FORCE_STUB",
      "required": false,
      "description": "Set to true to force local stub even when API base is configured"
    },
    {
      "name": "CHECKOUT_API_MODE",
      "required": false,
      "description": "stub (default) | live. Live disables instant checkout and requires STRIPE_SECRET_KEY."
    },
    {
      "name": "STRIPE_SECRET_KEY",
      "required": false,
      "description": "Server-only Stripe secret for live Checkout Sessions (never commit real values)"
    },
    {
      "name": "STRIPE_WEBHOOK_SECRET",
      "required": false,
      "description": "Server-only Stripe webhook signing secret for POST /v1/stripe/webhook"
    }
  ],
  "stripeLive": {
    "webhookPath": "/v1/stripe/webhook",
    "checkoutHost": "https://checkout.stripe.com/",
    "priceMapSource": "shared/billing/web-checkout-products.json#stripePriceId",
    "failsClosedWithoutSecret": true,
    "sandboxFallbackForbiddenInLive": true
  },
  "api": {
    "checkout": {
      "method": "POST",
      "path": "/v1/checkout",
      "body": [
        "webProductId",
        "cloudAccountId",
        "successUrl",
        "cancelUrl"
      ],
      "responses": [
        {
          "status": "completed",
          "fields": [
            "webProductId",
            "purchaseToken"
          ]
        },
        {
          "status": "owned",
          "fields": [
            "webProductId",
            "purchaseToken"
          ]
        },
        {
          "status": "checkout",
          "fields": [
            "url"
          ]
        }
      ]
    },
    "entitlements": {
      "method": "GET",
      "path": "/v1/entitlements",
      "query": [
        "cloudAccountId"
      ],
      "response": {
        "entitlements": [
          "webProductId",
          "purchaseToken"
        ]
      }
    },
    "fulfill": {
      "method": "POST",
      "path": "/v1/fulfill",
      "body": [
        "sessionId",
        "cloudAccountId"
      ],
      "response": {
        "entitlements": [
          "webProductId",
          "purchaseToken"
        ]
      }
    }
  },
  "returnQuery": {
    "billing": "success|cancel",
    "session_id": "Stripe/Checkout session id when billing=success"
  },
  "skus": [
    {
      "sku": "fish.full_harbor_unlock",
      "webProductId": "fish.full_harbor_unlock",
      "androidProductId": "fish_full_harbor_unlock",
      "grantsCosmetic": null

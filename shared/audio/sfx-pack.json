{
  "phase": 19,
  "schema": "fish.audio.sfx_pack.v1",
  "description": "Post-1.0 Phase 19 \u2014 authored mono WAV stingers for catch / cut / sell / UI (plus abandon, upgrade, rush). Buses keep mute, SFX gain, voice cap, and Android/Web focus-lifecycle policy. Phase 20 replaces procedural ambience with authored music beds. Finish 2.0 Phase 21 adds pack-2 stingers; Finish 3.0 Phase 23 adds pack-3 rival/travel/hire/prestige/loan/trophy stingers; Finish 4.0 Phase 23 adds pack-4 decor/cosmetic/endgame/contract/bait/unlock/break/spoil stingers; Finish 5.0 Phase 12 adds pack-5 cast/spoil/service/contract/quest pressure stingers; Finish 6.0 Phase 12 adds pack-6 nest/roast/ferment/school/aurora cozy stingers.",
  "sampleRate": 22050,
  "channels": 1,
  "encoding": "pcm_s16le",
  "format": "wav",
  "generator": "shared/tools/generate_sfx_pack.py",
  "npmScript": "sfx:generate",
  "validateScript": "sfx:validate",
  "sourceDir": "shared/audio/sfx",
  "webPublicDir": "web/public/sfx",
  "androidRawDir": "app/src/main/res/raw",
  "androidRawPrefix": "sfx_",
  "maxBytesPerClip": 24576,
  "maxTotalBytes": 560000,
  "maxDurationMs": 420,
  "voiceCostPerClip": 1,
  "maxSfxVoices": 6,
  "busPolicy": {
    "respectMute": true,
    "respectSfxVolume": true,
    "androidFocusSilence": true,
    "webLifecycleSuspend": true,
    "proceduralFallback": false,
    "ambienceRemainsProceduralUntilPhase": 20
  },

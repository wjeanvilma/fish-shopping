{
  "phase": 20,
  "schema": "fish.audio.music_pack.v1",
  "description": "Post-1.0 Phase 20 \u2014 authored harbor/shop loop beds with mute, SFX duck, and focus-loss duck/silence. Replaces Phase 19 procedural ambience; size-budgeted for mobile. Finish 2.0 Phase 21 adds festival/storm beds; Finish 3.0 Phase 23 adds night/rival beds; Finish 4.0 Phase 23 adds endgame/ledger beds. Ducking policy stays frozen.",
  "sampleRate": 22050,
  "channels": 1,
  "encoding": "pcm_s16le",
  "format": "wav",
  "generator": "shared/tools/generate_music_pack.py",
  "npmScript": "music:generate",
  "validateScript": "music:validate",
  "sourceDir": "shared/audio/music",
  "webPublicDir": "web/public/music",
  "androidRawDir": "app/src/main/res/raw",
  "androidRawPrefix": "music_",
  "loopDurationSec": 4,
  "maxBytesPerBed": 190000,
  "maxTotalBytes": 1600000,
  "masterMusicScale": 0.42,
  "beds": [
    {
      "id": "harbor",
      "file": "harbor.wav",
      "androidRaw": "music_harbor",
      "role": "harbor",
      "design": "soft water wash + low fifth pad for pier / outdoors"
    },
    {
      "id": "shop",
      "file": "shop.wav",
      "androidRaw": "music_shop",
      "role": "shop",
      "design": "warm major pad with light pulse for counter / station"
    },
    {
      "id": "festival",
      "file": "festival.wav",
      "androidRaw": "music_festival",
      "role": "festival",
      "design": "bright pentatonic sparkle pad for seasonal weekends",
      "pack2": true
    },
    {
      "id": "storm",
      "file": "storm.wav",
      "androidRaw": "music_storm",
      "role": "storm",
      "design": "low rumble + sparse rain ticks for storm weather",
      "pack2": true
    },
    {
      "id": "night",
      "file": "night.wav",
      "androidRaw": "music_night",
      "role": "night",
      "design": "dark nocturnal pad + soft tide wash for dusk/night",
      "pack3": true
    },
    {
      "id": "rival",
      "file": "rival.wav",
      "androidRaw": "music_rival",
      "role": "rival",
      "design": "tense low pulse + dissonant fifth for rival pressure",
      "pack3": true
    },
    {
      "id": "endgame",
      "file": "endgame.wav",
      "androidRaw": "music_endgame",
      "role": "endgame",
      "design": "crowned major pad + distant harbor horns for endgame board",
      "pack4": true
    },
    {
      "id": "ledger",
      "file": "ledger.wav",
      "androidRaw": "music_ledger",
      "role": "ledger",
      "design": "soft ticking ledger pad for outstanding loan pressure",
      "pack4": true
    }
  ],
  "defaultBed": "harbor",
  "bedSwitch": {
    "festivalWhen": [
      "seasonal_active"
    ],
    "stormWhen": [
      "weather_storm"
    ],
    "rivalWhen": [
      "rival_pressure"
    ],
    "nightWhen": [
      "tide_night_or_dusk"
    ],
    "shopWhen": [
      "station_open"
    ],
    "harborOtherwise": true,
    "endgameWhen": [
      "endgame_board_unlocked"
    ],
    "ledgerWhen": [
      "loan_outstanding"
    ]
  },
  "ducking": {
    "sfxDuckFactor": 0.35,
    "sfxDuckRecoveryMs": 280,
    "focusLossSilence": true,
    "focusTransientCanDuckFactor": 0.25,
    "webHiddenSuspendsContext": true,
    "respectMute": true,
    "respectMusicVolume": true
  },
  "replacesProceduralAmbience": true,
  "preflightGates": [
    "shared/audio/music-pack.json",
    "shared/audio/sfx-pack.json",
    "web/src/audio/audioBus.ts",
    "app/src/main/java/com/willio/jeanvilma/fishshopping/audio/AudioBus.kt"
  ]
}

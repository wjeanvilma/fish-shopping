{
  "phase": 27,
  "schema": "fish.android.release_hardening.v1",
  "description": "Android release build gates: R8 minify, Autobackup excludes for corruptible save slots, CI assembleRelease.",
  "compileSdk": 37,
  "kotlin": "2.4.0",
  "filament": "1.77.3",
  "minify": {
    "enabled": true,
    "dsl": "android.buildTypes.release.optimization.enable",
    "gradleProperty": "android.r8.gradual.support=true",
    "keepRulesFile": "app/proguard-rules.pro",
    "includeDefaultOptimize": true
  },
  "signing": {
    "ciReleaseUsesDebugKeystore": false,
    "catalog": "shared/android/release-signing.json",
    "signingConfigName": "upload",
    "note": "Phase 4: assembleRelease uses the upload keystore from FISH_UPLOAD_* / fish.upload.*. Debug fallback is explicit opt-in only."
  },
  "backupExcludes": {
    "sharedPreferences": [
      "fish_shopping_entitlements.xml",
      "fish_shopping_pending_entitlements.xml"
    ],
    "files": [
      "harbor_save_latest.json",
      "harbor_save_previous.json",
      "harbor_save_latest.json.new",
      "harbor_save_previous.json.new"
    ],
    "reason": "Save slots are AtomicFile-rotated and recovered in-app; Autobackup of a mid-write latest can corrupt both slots. Entitlements restore via Play Billing (release) or stub (debug)."
  },
  "ci": {
    "task": ":app:bundleRelease",
    "assembleTask": ":app:assembleRelease",
    "fallback": ":app:assembleDebug",
    "aabCatalog": "shared/android/aab-ci.json",
    "artifacts": {
      "aab": "app/build/outputs/bundle/release/app-release.aab",
      "mapping": "app/build/outputs/mapping/release/mapping.txt"
    }
  },
  "dataExtractionRules": "app/src/main/res/xml/data_extraction_rules.xml",
  "fullBackupContent": "app/src/main/res/xml/backup_rules.xml"
}

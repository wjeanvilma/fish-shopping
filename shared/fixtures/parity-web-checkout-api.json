{
  "schema": "fish.fixture.parity_web_checkout_api.v1",
  "description": "Finish 2.0 Phase 25: web checkout API contract vectors (stub + session fulfill).",
  "checkoutApiMarker": "authored-finish-2.0-phase-25",
  "routeCount": 3,
  "skuFloor": 4,
  "localEmulatorDefaultBase": "http://localhost:8787",
  "clientEnvKey": "VITE_BILLING_API_BASE",

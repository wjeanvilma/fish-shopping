{
  "phase": 27,
  "schema": "fish.fixtures.parity_lock.v1",
  "description": "Post-1.0 Phase 27 — expanded Kotlin↔web golden parity suite for economy, unlocks, tutorial, and entitlements after polish. Schema 20 / content 1.0.1 frozen.",
  "contentVersion": "1.0.1",
  "schemaVersion": 20,
  "constraints": {
    "byteIdenticalSnapshots": true,
    "sharedFixturesOnly": true,

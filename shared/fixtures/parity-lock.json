      "id": "prng",
      "title": "Mulberry32 vectors",
      "fixture": "shared/fixtures/prng-vectors.json",
      "covers": ["rng"]
    },
    {
      "id": "starter_line",
      "title": "Starter-line economy + tutorial",
      "fixture": "shared/fixtures/starter-line.json",
      "snapshot": "shared/fixtures/snapshot-starter-line-t2500.json",
      "snapshotTick": 2500,
      "covers": ["economy", "tutorial", "upgrades", "quests", "contracts", "workers"]
    },
    {
      "id": "entitlements_unlock",
      "title": "Full-harbor unlock + cosmetic (travel unlocked)",
      "fixture": "shared/fixtures/parity-entitlements.json",
      "covers": ["entitlements", "unlocks", "cosmetics"]
    },
    {
      "id": "legacy_migrations",
      "title": "Legacy snapshot migrations → schema 20",
      "fixtures": [
        "shared/fixtures/legacy/snapshot-v1-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v12-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v13-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v14-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v15-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v16-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v17-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v18-starter-line-t2500.json",
        "shared/fixtures/legacy/snapshot-v19-starter-line-t2500.json"
      ],
      "covers": ["persistence", "migrations"]
    }
  ],
  "expandedExpectFields": [
    "harborId",
    "fullHarborUnlock",
    "unlockedCosmetics",
    "ownedDecor",
    "loanOwed",
    "coinGoal",
    "workers",
    "tutorialIndex",
    "coins",
    "ownedUpgrades",
    "completedQuests",
    "stats"

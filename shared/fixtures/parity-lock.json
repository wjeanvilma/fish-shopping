  "recordCommand": "./gradlew :game-core:test --tests '*ParityLock*' --tests StarterLineFixtureTest -PrecordFixtures=true",
  "preflightGates": [
    "shared/fixtures/parity-lock.json",
    "shared/fixtures/starter-line.json",
    "shared/fixtures/parity-entitlements.json",
    "shared/fixtures/snapshot-starter-line-t2500.json",
    "web/src/engine/parityLock.ts",
    "game-core/src/main/kotlin/com/willio/jeanvilma/fishshopping/core/sim/ParityLock.kt"
  ]
